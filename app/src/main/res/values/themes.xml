<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-Compose splash/window theme. DayNight => follows system at launch;
         Compose ShipKaroTheme takes over for in-app theming. -->
    <style name="Theme.ShipKaroKit" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
