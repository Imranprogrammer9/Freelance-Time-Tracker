<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FCM notifications. Runtime-requested on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      In-app billing. Required by RevenueCat / Google Play Billing for purchases,
      and needed for Google Play Console to unlock in-app product creation on your
      uploaded build. `/kit-setup-paywall` uncomments this automatically when you
      turn the paywall on; leave it commented for a free (no-paywall) app.
    -->
    <!-- <uses-permission android:name="com.android.vending.BILLING" /> -->

    <!--
      Opt-in permissions for the pre-built KitPermissionScreen flows (feature/permissions).
      Uncomment the lines for permissions your app actually uses. Each is a "dangerous"
      permission requiring a runtime prompt — declaring without prompting at runtime does
      NOT grant access. The corresponding kit screen is at:
        feature/permissions/PermissionScreens.kt :: <Permission>PermissionScreen

      Uncommenting an unused permission is harmless (no behaviour change) but bloats your
      Play Store privacy/data-safety form, so cull aggressively before shipping.
    -->
    <!-- <uses-permission android:name="android.permission.CAMERA" /> -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->
    <!-- Photo gallery — modern (API 33+) -->
    <!-- <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> -->
    <!-- Photo gallery — legacy (API ≤ 32). Pair with maxSdkVersion to drop on newer devices. -->
    <!-- <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" /> -->
    <!-- <uses-permission android:name="android.permission.READ_CONTACTS" /> -->
    <!-- <uses-permission android:name="android.permission.READ_CALENDAR" /> -->
    <!-- <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" /> -->
    <!-- <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> -->
    <!-- Step counter / workout detection (API 29+). -->
    <!-- <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" /> -->

    <application
        android:name=".KitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShipKaroKit"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ShipKaroKit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OAuth callback for Supabase Auth (and similar). Change the scheme + host
              per-app and configure the same value as the Redirect URL in your Supabase
              project's Auth settings. Default = shipkaro://auth-callback.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="shipkaro"
                    android:host="auth-callback" />
            </intent-filter>

            <!--
              App Links for https deep links — DISABLED by default, on purpose.
              The kit ships no real domain, and an ACTIVE autoVerify filter for a
              domain you don't own makes Google Play Console flag "1 domain not
              verified / failed domain checks" on your app.
              To enable: uncomment the block below, set android:host to YOUR domain,
              and host a /.well-known/assetlinks.json (with your app's signing cert
              SHA-256) on that domain so Play can verify it.
            -->
            <!--
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="your-domain.example" />
            </intent-filter>
            -->
        </activity>

        <!-- FCM message receiver. Inert until google-services.json is added. -->
        <service
            android:name=".core.push.KitMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Android 13+ per-app language service. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          Sentry — disable the SDK's auto-init ContentProvider. KitApplication
          calls SentryAndroid.init manually, gated on KitConfig.SENTRY_ENABLED +
          a non-blank BuildConfig.SENTRY_DSN. Without this opt-out, Sentry's
          SentryInitProvider runs at process start (before KitApplication),
          finds no DSN in AndroidManifest meta-data, and throws
          IllegalArgumentException("DSN is required") — crashing the app at
          launch for any clone that hasn't set sentry.dsn yet.
        -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
    </application>
</manifest>
