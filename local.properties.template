# -----------------------------------------------------------------------
# local.properties.template
#
# Copy this file to local.properties and fill in your values:
#   cp local.properties.template local.properties
#
# local.properties is git-ignored and must NEVER be committed.
#
# The kit builds and runs with every value left as-is — each integration
# degrades gracefully when its key is empty. Fill in only what you use.
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Android SDK path
#
# Android Studio usually writes this line for you. If it is missing or
# wrong, set sdk.dir for your operating system:
#
#   macOS:    /Users/<your_username>/Library/Android/sdk
#   Windows:  C:/Users/<YourUsername>/AppData/Local/Android/Sdk
#             (older alt: C:/Program Files (x86)/Android/android-sdk)
#   Linux:    /home/<your_username>/Android/Sdk
#
# Windows: use FORWARD slashes (/) as shown above. Backslashes need to be
# escaped in this file and are the #1 cause of setup failures.
#
# Not sure of the path? Open Android Studio -> Settings -> Appearance &
# Behavior -> System Settings -> Android SDK. The path is at the top,
# labelled "Android SDK Location".
# -----------------------------------------------------------------------
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# -----------------------------------------------------------------------
# Supabase   (needed only if KitConfig.AUTH_PROVIDER = SUPABASE)
# Supabase dashboard -> Project Settings -> API
# -----------------------------------------------------------------------
supabase.url=https://YOUR_PROJECT_ID.supabase.co
supabase.key=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------
# RevenueCat   (needed only if KitConfig.PAYWALL_ENABLED = true)
# app.revenuecat.com -> Project Settings -> API keys -> Google / Android key
# The Android key starts with "goog_".
# -----------------------------------------------------------------------
revenuecat.android.api.key=goog_YOUR_ANDROID_KEY

# -----------------------------------------------------------------------
# PostHog   (needed only if you enabled PostHog analytics)
# app.posthog.com -> Project Settings -> Project API Key
# Host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU)
# -----------------------------------------------------------------------
posthog.api.key=phc_YOUR_POSTHOG_KEY
posthog.host=https://us.i.posthog.com

# -----------------------------------------------------------------------
# Not set here:
#  - Google Sign-In Web client ID -> KitConfig.kt (GOOGLE_WEB_CLIENT_ID).
#  - Firebase -> uses google-services.json placed at app/, not a key here.
# See the /setup-auth command for details.
# -----------------------------------------------------------------------
